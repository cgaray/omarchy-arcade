#!/bin/bash

# Launch a game and hold the desktop still while it runs.
#
# Launch the emulator and restore desktop settings after the session.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-arcade"
PLAYS_FILE="$STATE_DIR/plays.json"
RETROARCH_CMD="${RETROARCH_CMD:-retroarch}"
OMARCHY_SHELL_CMD="${OMARCHY_SHELL_CMD:-omarchy-shell}"
OMARCHY_IDLE_CMD="${OMARCHY_IDLE_CMD:-omarchy-toggle-idle}"

CORE=""
ROM=""
SLOT=""
SILENCE_NOTIFICATIONS=1
SUPPRESS_IDLE=1

die() {
  echo "omarchy-arcade-launch: $*" >&2
  exit 1
}

usage() {
  cat <<USAGE
Usage: omarchy-arcade-launch --core <path> --rom <path> [--slot <n|auto>]

Launches a libretro core fullscreen, optionally resuming a save state, with
notifications silenced and idle suppressed for the duration.

  --core                Absolute path to the libretro core (.so)
  --rom                 Absolute path to the ROM
  --slot                Save state slot to resume from: 0-9, or "auto"
  --keep-notifications  Leave do-not-disturb alone
  --allow-idle          Leave the screensaver and lock screen alone
USAGE
}

while (( $# )); do
  case "$1" in
    --core) CORE="${2:-}"; shift 2 ;;
    --rom)  ROM="${2:-}";  shift 2 ;;
    --slot) SLOT="${2:-}"; shift 2 ;;
    --keep-notifications) SILENCE_NOTIFICATIONS=0; shift ;;
    --allow-idle) SUPPRESS_IDLE=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n $CORE ]] || { usage >&2; die "--core is required"; }
[[ -n $ROM ]]  || { usage >&2; die "--rom is required"; }
[[ -f $CORE ]] || die "core not found: $CORE"
[[ -f $ROM ]]  || die "ROM not found: $ROM"
command -v "$RETROARCH_CMD" >/dev/null || die "retroarch is not installed"

# --- Save and restore the desktop ------------------------------------------

# Read the current state before changing it, so a user who was already in DND
# is still in DND when the game exits. Both reads tolerate a shell that is not
# running (a game launched from a TTY), in which case there is nothing to
# restore either.
PREV_DND=""
PREV_IDLE=""

capture_desktop() {
  (( SILENCE_NOTIFICATIONS )) && PREV_DND=$("$OMARCHY_SHELL_CMD" -q notifications dndState 2>/dev/null | tr -d '[:space:]')
  (( SUPPRESS_IDLE )) && PREV_IDLE=$("$OMARCHY_IDLE_CMD" status 2>/dev/null | jq -r '.enabled // false' 2>/dev/null)
}

refresh_indicators() {
  "$OMARCHY_SHELL_CMD" -q omarchy.indicators refresh >/dev/null 2>&1
}

apply_desktop_policy() {
  (( SILENCE_NOTIFICATIONS )) && "$OMARCHY_SHELL_CMD" -q notifications setDnd true >/dev/null 2>&1
  (( SUPPRESS_IDLE )) && "$OMARCHY_IDLE_CMD" stay-awake >/dev/null 2>&1
  refresh_indicators
}

restore_desktop() {
  # Only undo what we actually changed. A user who was already in
  # do-not-disturb before launching stays in it afterwards.
  [[ $PREV_DND == "false" ]] && "$OMARCHY_SHELL_CMD" -q notifications setDnd false >/dev/null 2>&1
  [[ $PREV_IDLE == "false" ]] && "$OMARCHY_IDLE_CMD" allow-idle >/dev/null 2>&1
  refresh_indicators
  return 0
}
trap restore_desktop EXIT

capture_desktop
apply_desktop_policy

# --- Build the RetroArch invocation ----------------------------------------

args=(-L "$CORE" "$ROM" --fullscreen)
appendcfg=""

case "$SLOT" in
  "")
    ;;
  auto)
    # The auto state is the one slot `--entryslot` cannot name, so ask for it
    # the only other way RetroArch offers: a config fragment layered on top of
    # the user's own, which leaves retroarch.cfg untouched.
    appendcfg=$(mktemp -t arcade-resume-XXXXXX.cfg) || die "could not create temp config"
    printf 'savestate_auto_load = "true"\n' >"$appendcfg"
    args+=(--appendconfig "$appendcfg")
    ;;
  [0-9])
    args+=(--entryslot "$SLOT")
    ;;
  *)
    die "invalid --slot: $SLOT (expected 0-9 or auto)"
    ;;
esac

cleanup_cfg() { [[ -n $appendcfg && -f $appendcfg ]] && rm -f "$appendcfg"; }
restore_all() { cleanup_cfg; restore_desktop; }
trap restore_all EXIT

# A stop or Ctrl+C is meant for the game, not just for this script: hand the
# signal on and keep waiting, so the desktop policy is only undone after
# RetroArch has actually exited -- a session shutdown must not unsilence
# notifications under a still-running game.
forward_signal() {
  [[ -n ${ra_pid:-} ]] && kill -s "$1" "$ra_pid" 2>/dev/null
  return 0
}
trap 'forward_signal INT' INT
trap 'forward_signal TERM' TERM

# --- Play -------------------------------------------------------------------

started=$(date +%s)
"$RETROARCH_CMD" "${args[@]}" &
ra_pid=$!
wait "$ra_pid"
status=$?
# An interrupted wait returns >128 while the child may still be running;
# block until it is really gone so status is RetroArch's own.
while kill -0 "$ra_pid" 2>/dev/null; do
  wait "$ra_pid"
  status=$?
done
ended=$(date +%s)

record_session() {
  # Keyed by ROM path, matching the scanner's `key`. Written through a temp file
  # so an interrupted write cannot leave a truncated plays.json behind, which
  # would silently reset every playtime the user has accumulated.
  mkdir -p "$STATE_DIR"
  [[ -f $PLAYS_FILE ]] || echo '{}' >"$PLAYS_FILE"

  # Temp file lives beside plays.json so the final mv is a rename -- a /tmp
  # tempfile would make this a cross-filesystem copy, which is exactly the
  # interrupted-write truncation this dance exists to prevent.
  tmp=$(mktemp "$STATE_DIR/.plays-XXXXXX.json") || return 0
  if jq \
    --arg key "$ROM" \
    --argjson lastPlayed "$ended" \
    --argjson seconds "$(( ended - started ))" \
    '.[$key] = {
       lastPlayed: $lastPlayed,
       seconds: ((.[$key].seconds // 0) + $seconds),
       count: ((.[$key].count // 0) + 1)
     }' "$PLAYS_FILE" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$PLAYS_FILE"
  else
    rm -f "$tmp"
  fi
}

record_session

exit "$status"
