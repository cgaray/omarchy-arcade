#!/bin/bash

# Launch a game and persist its play history.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-arcade"
PLAYS_FILE="$STATE_DIR/plays.json"
RETROARCH_CMD="${RETROARCH_CMD:-retroarch}"
READ_HELPER="$(dirname "${BASH_SOURCE[0]}")/../lib/omarchy-arcade-read"

CORE=""
ROM=""
SLOT=""
SIGNAL_GRACE=5
signal_sent=0
signal_deadline=0

warn() {
  echo "omarchy-arcade-launch: $*" >&2
}

die() {
  warn "$*"
  exit 1
}

# plays.json is read whole by jq when a session is recorded. The cap is
# applied to the one stream jq parses rather than to a path sized separately
# and reopened, so nothing can grow or be swapped between a check and the
# read. Same ceiling, under the same name, as the scanner applies to this
# file; a value that is not a positive integer is ignored rather than
# obeyed, so a stray empty variable can never mean "unlimited".
MAX_PLAYS_BYTES=$((16 * 1024 * 1024))
if [[ ${OMARCHY_ARCADE_MAX_JSON_BYTES:-} =~ ^[1-9][0-9]*$ ]]; then
  MAX_PLAYS_BYTES=$OMARCHY_ARCADE_MAX_JSON_BYTES
fi
command -v perl >/dev/null || die "perl is required"
# Waiting is the right answer to another launcher recording its session, not
# to one that is wedged holding the lock.
LOCK_WAIT=30

usage() {
  cat <<USAGE
Usage: omarchy-arcade-launch --core <path> --rom <path> [--slot <n|auto>]

Launches a libretro core fullscreen, optionally resuming a save state.

  --core                Absolute path to the libretro core (.so)
  --rom                 Absolute path to the ROM
  --slot                Save state slot to resume from: 0-9, or "auto"
USAGE
}

while (( $# )); do
  case "$1" in
    --core) CORE="${2:-}"; shift 2 ;;
    --rom)  ROM="${2:-}";  shift 2 ;;
    --slot) SLOT="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n $CORE ]] || { usage >&2; die "--core is required"; }
[[ -n $ROM ]]  || { usage >&2; die "--rom is required"; }
[[ -f $CORE ]] || die "core not found: $CORE"
[[ -f $ROM ]]  || die "ROM not found: $ROM"
command -v "$RETROARCH_CMD" >/dev/null || die "retroarch is not installed"

# --- Build the RetroArch invocation ----------------------------------------

args=(-L "$CORE" "$ROM" --fullscreen)
appendcfg=""

case "$SLOT" in
  "")
    ;;
  auto)
    # The auto state is the one slot `--entryslot` cannot name, so ask for it
    # the only other way RetroArch offers: a config fragment layered on top of
    # the user's own, which leaves retroarch.cfg untouched.
    appendcfg=$(mktemp -t arcade-resume-XXXXXX.cfg) || die "could not create temp config"
    printf 'savestate_auto_load = "true"\n' >"$appendcfg"
    args+=(--appendconfig "$appendcfg")
    ;;
  [0-9])
    args+=(--entryslot "$SLOT")
    ;;
  *)
    die "invalid --slot: $SLOT (expected 0-9 or auto)"
    ;;
esac

# Trap callbacks run by way of the shell, not by name, so shellcheck reads
# them as never invoked and their bodies as unreachable. Neither is true.
# shellcheck disable=SC2317,SC2329
cleanup_cfg() { [[ -n ${appendcfg:-} && -f $appendcfg ]] && rm -f "$appendcfg"; }
trap cleanup_cfg EXIT

# A stop or Ctrl+C is meant for the game, not just for this script: hand the
# signal on and keep waiting so the launcher's status remains RetroArch's own.
# shellcheck disable=SC2317,SC2329
forward_signal() {
  signal_sent=1
  signal_deadline=$((SECONDS + SIGNAL_GRACE))
  [[ -n ${ra_pid:-} ]] && kill -s "$1" "$ra_pid" 2>/dev/null
  return 0
}
trap 'forward_signal INT' INT
trap 'forward_signal TERM' TERM

# --- Play -------------------------------------------------------------------

started=$(date +%s)
"$RETROARCH_CMD" "${args[@]}" &
ra_pid=$!
wait "$ra_pid"
status=$?
# An interrupted wait returns >128 while the child may still be running;
# poll until it is really gone so a child that ignores a forwarded signal can
# be escalated without leaving the launcher blocked in a second wait.
if kill -0 "$ra_pid" 2>/dev/null; then
  while kill -0 "$ra_pid" 2>/dev/null; do
    if (( signal_sent && SECONDS >= signal_deadline )); then
      kill -KILL "$ra_pid" 2>/dev/null || true
      signal_sent=0
    fi
    sleep 0.1
  done
  wait "$ra_pid"
  status=$?
fi
ended=$(date +%s)

record_session() {
  # Keyed by ROM path, matching the scanner's `key`. Written through a temp file
  # so an interrupted write cannot leave a truncated plays.json behind, which
  # would silently reset every playtime the user has accumulated.
  mkdir -p "$STATE_DIR"

  # Temp file lives beside plays.json so the final mv is a rename -- a /tmp
  # tempfile would make this a cross-filesystem copy, which is exactly the
  # interrupted-write truncation this dance exists to prevent.
  #
  # A lockfile serializes writers: two overlapping launches each performed an
  # unsynchronized read-modify-write, and whichever mv landed last silently
  # dropped the other session's stats.
  local tmp lock_fd=9
  exec {lock_fd}>"$STATE_DIR/.plays.lock" || return 0
  if ! flock -w "$LOCK_WAIT" "$lock_fd"; then
    warn "gave up waiting ${LOCK_WAIT}s to record this session"
    exec {lock_fd}>&-
    return 0
  fi

  # Create a missing history file through a destination-local temp file. A
  # symlink or FIFO already at this path is left for the safe reader to reject;
  # mv never follows the final path component.
  if [[ ! -e $PLAYS_FILE && ! -L $PLAYS_FILE ]]; then
    local initial
    initial=$(mktemp "$STATE_DIR/.plays-XXXXXX.json") || {
      exec {lock_fd}>&-
      return 0
    }
    printf '{}\n' >"$initial" && mv -f "$initial" "$PLAYS_FILE" || rm -f "$initial"
  fi

  tmp=$(mktemp "$STATE_DIR/.plays-XXXXXX.json") || {
    exec {lock_fd}>&-
    return 0
  }
  # A capped read feeds jq directly. If the file is larger than the cap it
  # arrives truncated and jq refuses it, which lands in the same branch as a
  # corrupt one: this session goes unrecorded and the existing history is
  # left exactly as it was. Overwriting it with what little parsed would
  # reset every playtime the user has accumulated.
  local elapsed=$(( ended - started ))
  # A clock stepped backwards mid-session must not subtract from the total.
  (( elapsed >= 0 )) || elapsed=0
  if "$READ_HELPER" "$MAX_PLAYS_BYTES" "$PLAYS_FILE" 2>/dev/null | jq \
    --arg key "$ROM" \
    --argjson lastPlayed "$ended" \
    --argjson seconds "$elapsed" \
    'if type == "object" then . else empty end
     | .[$key] = {
         lastPlayed: $lastPlayed,
         seconds: ((.[$key].seconds // 0) + $seconds),
         count: ((.[$key].count // 0) + 1)
       }' >"$tmp" 2>/dev/null && [[ -s $tmp ]]; then
    mv -f "$tmp" "$PLAYS_FILE"
  else
    warn "left play history untouched: $PLAYS_FILE is unreadable, malformed, or larger than $MAX_PLAYS_BYTES bytes"
    rm -f "$tmp"
  fi
  exec {lock_fd}>&-
}

# Only completed sessions are recorded: a non-zero exit means the core died
# before or during play, and counting crashes as sessions pollutes playtime
# and every ordering built on it. A session cut short by a forwarded signal
# is lost too -- accepted here, so crash loops stay out of the stats.
if (( status == 0 )); then
  record_session
fi

exit "$status"
