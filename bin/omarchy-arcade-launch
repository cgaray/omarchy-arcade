#!/bin/bash

# Launch a game and persist its play history.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-arcade"
PLAYS_FILE="$STATE_DIR/plays.json"
RETROARCH_CMD="${RETROARCH_CMD:-retroarch}"

CORE=""
ROM=""
SLOT=""

die() {
  echo "omarchy-arcade-launch: $*" >&2
  exit 1
}

usage() {
  cat <<USAGE
Usage: omarchy-arcade-launch --core <path> --rom <path> [--slot <n|auto>]

Launches a libretro core fullscreen, optionally resuming a save state.

  --core                Absolute path to the libretro core (.so)
  --rom                 Absolute path to the ROM
  --slot                Save state slot to resume from: 0-9, or "auto"
USAGE
}

while (( $# )); do
  case "$1" in
    --core) CORE="${2:-}"; shift 2 ;;
    --rom)  ROM="${2:-}";  shift 2 ;;
    --slot) SLOT="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n $CORE ]] || { usage >&2; die "--core is required"; }
[[ -n $ROM ]]  || { usage >&2; die "--rom is required"; }
[[ -f $CORE ]] || die "core not found: $CORE"
[[ -f $ROM ]]  || die "ROM not found: $ROM"
command -v "$RETROARCH_CMD" >/dev/null || die "retroarch is not installed"

# --- Build the RetroArch invocation ----------------------------------------

args=(-L "$CORE" "$ROM" --fullscreen)
appendcfg=""

case "$SLOT" in
  "")
    ;;
  auto)
    # The auto state is the one slot `--entryslot` cannot name, so ask for it
    # the only other way RetroArch offers: a config fragment layered on top of
    # the user's own, which leaves retroarch.cfg untouched.
    appendcfg=$(mktemp -t arcade-resume-XXXXXX.cfg) || die "could not create temp config"
    printf 'savestate_auto_load = "true"\n' >"$appendcfg"
    args+=(--appendconfig "$appendcfg")
    ;;
  [0-9])
    args+=(--entryslot "$SLOT")
    ;;
  *)
    die "invalid --slot: $SLOT (expected 0-9 or auto)"
    ;;
esac

# Trap callbacks run by way of the shell, not by name, so shellcheck reads
# them as never invoked and their bodies as unreachable. Neither is true.
# shellcheck disable=SC2317,SC2329
cleanup_cfg() { [[ -n ${appendcfg:-} && -f $appendcfg ]] && rm -f "$appendcfg"; }
trap cleanup_cfg EXIT

# A stop or Ctrl+C is meant for the game, not just for this script: hand the
# signal on and keep waiting so the launcher's status remains RetroArch's own.
# shellcheck disable=SC2317,SC2329
forward_signal() {
  [[ -n ${ra_pid:-} ]] && kill -s "$1" "$ra_pid" 2>/dev/null
  return 0
}
trap 'forward_signal INT' INT
trap 'forward_signal TERM' TERM

# --- Play -------------------------------------------------------------------

started=$(date +%s)
"$RETROARCH_CMD" "${args[@]}" &
ra_pid=$!
wait "$ra_pid"
status=$?
# An interrupted wait returns >128 while the child may still be running;
# block until it is really gone so status is RetroArch's own.
while kill -0 "$ra_pid" 2>/dev/null; do
  wait "$ra_pid"
  status=$?
done
ended=$(date +%s)

record_session() {
  # Keyed by ROM path, matching the scanner's `key`. Written through a temp file
  # so an interrupted write cannot leave a truncated plays.json behind, which
  # would silently reset every playtime the user has accumulated.
  mkdir -p "$STATE_DIR"
  [[ -f $PLAYS_FILE ]] || printf '{}\n' >"$PLAYS_FILE"

  # Temp file lives beside plays.json so the final mv is a rename -- a /tmp
  # tempfile would make this a cross-filesystem copy, which is exactly the
  # interrupted-write truncation this dance exists to prevent.
  #
  # A lockfile serializes writers: two overlapping launches each performed an
  # unsynchronized read-modify-write, and whichever mv landed last silently
  # dropped the other session's stats.
  local tmp lock_fd=9
  exec {lock_fd}>"$STATE_DIR/.plays.lock" || return 0
  if ! flock "$lock_fd"; then
    exec {lock_fd}>&-
    return 0
  fi

  tmp=$(mktemp "$STATE_DIR/.plays-XXXXXX.json") || {
    exec {lock_fd}>&-
    return 0
  }
  if jq \
    --arg key "$ROM" \
    --argjson lastPlayed "$ended" \
    --argjson seconds "$(( ended - started ))" \
    '.[$key] = {
       lastPlayed: $lastPlayed,
       seconds: ((.[$key].seconds // 0) + $seconds),
       count: ((.[$key].count // 0) + 1)
     }' "$PLAYS_FILE" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$PLAYS_FILE"
  else
    rm -f "$tmp"
  fi
  exec {lock_fd}>&-
}

# Only completed sessions are recorded: a non-zero exit means the core died
# before or during play, and counting crashes as sessions pollutes playtime
# and every ordering built on it. A session cut short by a forwarded signal
# is lost too -- accepted here, so crash loops stay out of the stats.
if (( status == 0 )); then
  record_session
fi

exit "$status"
