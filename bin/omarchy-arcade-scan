#!/bin/bash

# Emit the RetroArch playlist library as one JSON object.

set -uo pipefail

RA_CONFIG_DIR="${RA_CONFIG_DIR:-$HOME/.config/retroarch}"
RA_CFG="$RA_CONFIG_DIR/retroarch.cfg"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-arcade"
PLAYS_FILE="$STATE_DIR/plays.json"
ADDED_FILE="$STATE_DIR/added.json"
CORES_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/arcade/cores.conf"
INFO_DIR=""
RECORDS_FILE=""
ADDED_TMP=""

die() {
  echo "omarchy-arcade-scan: $*" >&2
  exit 1
}

command -v jq >/dev/null || die "jq is required"

# Reported rather than fatal: a machine without RetroArch is a machine that
# has not installed it yet, and the panel offers Omarchy's installer instead
# of an error.
if command -v retroarch >/dev/null; then RETROARCH_PRESENT=true; else RETROARCH_PRESENT=false; fi

# RetroArch writes `key = "value"` with a literal ~ left unexpanded, and uses
# ":" to mean the config directory itself.
ra_cfg() {
  local key="$1" fallback="$2" value=""
  if [[ -f $RA_CFG ]]; then
    value=$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"\(.*\)\"[[:space:]]*$/\1/p" "$RA_CFG" | tail -n1)
  fi
  [[ -n $value ]] || value="$fallback"
  value="${value/#:/$RA_CONFIG_DIR}"
  value="${value/#\~/$HOME}"
  printf '%s' "$value"
}

PLAYLIST_DIR=$(ra_cfg playlist_directory "$RA_CONFIG_DIR/playlists")
SAVESTATE_DIR=$(ra_cfg savestate_directory "$RA_CONFIG_DIR/states")
THUMBNAIL_DIR=$(ra_cfg thumbnails_directory "$RA_CONFIG_DIR/thumbnails")
CORE_DIR=$(ra_cfg libretro_directory "/usr/lib/libretro")
INFO_DIR=$(ra_cfg libretro_info_path "/usr/share/libretro/info")

# Which cores can open which extension comes from RetroArch's own .info
# files, read by omarchy-arcade-cores, rather than a table maintained here.
# Taking RetroArch at its word means the candidate list is right for whatever
# the user actually has installed -- and it means several cores usually claim
# the same extension, which is a choice for the user rather than something to
# guess at quietly. cores.conf records that choice; until it is made, the
# first candidate is used so the game is still launchable, and the extension
# is reported as ambiguous so the panel can offer the picker.
declare -A EXT_CANDIDATES EXT_CHOICE CORE_SYSTEM

load_cores() {
  local raw
  raw=$("$(dirname "${BASH_SOURCE[0]}")/omarchy-arcade-cores" list 2>/dev/null) || return 1
  [[ -n $raw ]] || return 1

  local ext ids
  while IFS=$'\t' read -r ext ids; do
    [[ -n $ext ]] || continue
    EXT_CANDIDATES[$ext]="$ids"
  done < <(jq -r '.byExtension | to_entries[] | "\(.key)\t\(.value | join(" "))"' <<<"$raw" 2>/dev/null)

  local core
  while IFS=$'\t' read -r ext core; do
    [[ -n $ext ]] || continue
    EXT_CHOICE[$ext]="$core"
  done < <(jq -r '.choices | to_entries[] | "\(.key)\t\(.value)"' <<<"$raw" 2>/dev/null)

  # Core metadata supplies system names for core-resolved entries.
  local id system
  while IFS=$'\t' read -r id system; do
    [[ -n $id ]] || continue
    CORE_SYSTEM[$id]="$system"
  done < <(jq -r '.cores[] | "\(.id)\t\(.system)"' <<<"$raw" 2>/dev/null)

  CORES_JSON="$raw"
  INFO_DIR=$(jq -r '.meta.infoDir // ""' <<<"$raw" 2>/dev/null)
}

CORES_JSON="{}"

# The helpers below set a result variable rather than printing to stdout:
# capturing with $( ) forks a subshell per call, and at one call or more per
# ROM that cost dominated the scan.

# Resolves a core ID, filename, or absolute path to an installed .so.
core_path_for() {
  CORE_PATH=""
  local name="$1"
  [[ -n $name ]] || return 1
  # DETECT asks the scanner to resolve the core.
  [[ $name == DETECT ]] && return 1
  # Accept a core ID, filename, or absolute path.
  if [[ $name == /* ]]; then
    if [[ -f $name ]]; then CORE_PATH="$name"; return 0; fi
    return 1
  fi
  local candidate="$CORE_DIR/${name%_libretro.so}_libretro.so"
  if [[ -f $candidate ]]; then CORE_PATH="$candidate"; return 0; fi
  return 1
}

# Index save states by ROM basename and core directory.
declare -A STATE_SLOT STATE_MTIME STATE_THUMB STATE_SLOTS

index_states() {
  [[ -d $SAVESTATE_DIR ]] || return 0

  local f fname base slot mtime relative state_core key
  while IFS= read -r -d '' f; do
    fname="${f##*/}"
    # `.state.png` is the thumbnail beside a state, not a state itself.
    [[ $fname == *.png ]] && continue

    if [[ $fname == *.state ]]; then
      base="${fname%.state}"; slot=0
    elif [[ $fname == *.state.auto ]]; then
      base="${fname%.state.auto}"; slot=auto
    elif [[ $fname =~ ^(.+)\.state([0-9]+)$ ]] ; then
      base="${BASH_REMATCH[1]}"; slot="${BASH_REMATCH[2]}"
    else
      continue
    fi

    relative="${f#"$SAVESTATE_DIR/"}"
    if [[ $relative == */* ]]; then
      state_core="${relative%%/*}"
      state_core="${state_core##*/}"
      state_core="${state_core%_libretro.so}"
      state_core="${state_core,,}"
    else
      state_core=""
    fi
    key="$state_core|$base"
    mtime=$(stat -c %Y "$f" 2>/dev/null) || continue
    # Every slot is remembered, not only the newest: the inspector lets the
    # user resume a chosen one. Pairs collect as "slot:mtime"; newest_state
    # sorts them for emission.
    STATE_SLOTS[$key]+="${slot}:${mtime}"$'\n'
    if [[ -z ${STATE_MTIME[$key]:-} ]] || (( mtime > ${STATE_MTIME[$key]} )); then
      STATE_MTIME[$key]=$mtime
      STATE_SLOT[$key]=$slot
      if [[ -f "$f.png" ]]; then STATE_THUMB[$key]="$f.png"; else STATE_THUMB[$key]=""; fi
    fi
  done < <(find "$SAVESTATE_DIR" -type f -print0 2>/dev/null)
}

# "slot<TAB>mtime<TAB>thumbnail<TAB>slots" in STATE_INFO for a ROM, or
# non-zero when it has no state. The slot is a string rather than a number
# because "auto" is a real slot that no integer names, and reusing a negative
# integer for it collides with the "no state at all" sentinel. `slots` is a
# newest-first "slot:mtime,slot:mtime" list of every state the game has.
newest_state() {
  STATE_INFO=""
  local rom="$1" core="${2:-}"
  local base="${rom##*/}"
  base="${base%.*}"
  local core_key="" key
  if [[ -n $core ]]; then
    core_key="${core##*/}"
    core_key="${core_key%_libretro.so}"
    core_key="${core_key,,}"
  fi
  key="$core_key|$base"
  if [[ -z ${STATE_MTIME[$key]:-} ]]; then
    key="|$base"
  fi
  [[ -n ${STATE_MTIME[$key]:-} ]] || return 1
  local sorted
  sorted=$(sort -t: -k2,2rn <<<"${STATE_SLOTS[$key]:-}" | tr '\n' ',')
  sorted=${sorted%,}
  sorted=${sorted%,}
  # Fields join on the unit separator, not a tab: tab is IFS whitespace, so
  # the reader's `read` would collapse the empty thumbnail field into its
  # neighbour and shift every field after it.
  printf -v STATE_INFO '%s\x1f%s\x1f%s\x1f%s' \
    "${STATE_SLOT[$key]}" "${STATE_MTIME[$key]}" "${STATE_THUMB[$key]}" "$sorted"
}

# Resolve box art from the playlist database name into BOXART.
boxart_for() {
  BOXART=""
  local db="$1" label="$2"
  [[ -n $db && -n $label ]] || return 1
  db="${db%.lpl}"
  # RetroArch replaces illegal thumbnail characters with "_".
  local safe="${label//[&*\/:\`<>?\\|\"]/_}"
  local candidate="$THUMBNAIL_DIR/$db/Named_Boxarts/$safe.png"
  if [[ -f $candidate ]]; then BOXART="$candidate"; return 0; fi
  return 1
}

emit_games() {
  local playlist_count=0
  RECORDS_FILE=$(mktemp -t omarchy-arcade-scan-XXXXXX.jsonl) || die "could not create scan records"
  trap 'rm -f "$RECORDS_FILE" "${ADDED_TMP:-}"' EXIT

  # One enumeration at a time. The panel and the overlay each run this
  # script, and overlapping invocations used to race through the same
  # playlists and interleave added.json writers. Waiting costs milliseconds;
  # serializing sends every caller home with complete, current output
  # instead of inventing an exit-code contract for "another scan won".
  mkdir -p "$STATE_DIR" || die "could not create state directory"
  exec 9>>"$STATE_DIR/.scan.lock"
  flock 9

  index_states
  load_cores || true

  # Read playlist entries. One jq per playlist streams NUL-delimited fields
  # (path, label, core hint, pinned core) -- forking jq per ROM made a
  # 400-game scan spend seconds in process spawns alone.
  if [[ -d $PLAYLIST_DIR ]]; then
    local lpl
    while IFS= read -r -d '' lpl; do
      local db="${lpl##*/}"
      # A malformed playlist should cost its own entries, not the whole scan:
      # jq failing to parse, or the file not holding an object with an items
      # array, both fall through here as an empty stream.
      local rom label core_hint playlist_core ext core
      while IFS= read -r -d '' rom && IFS= read -r -d '' label \
        && IFS= read -r -d '' core_hint && IFS= read -r -d '' playlist_core; do
        # Ignore entries whose content file is missing.
        [[ -f $rom ]] || continue

        # Resolve the entry core in priority order.
        effective_ext "$rom" || true
        ext=$EXT
        if core_path_for "$core_hint"; then core=$CORE_PATH
        elif core_path_for "$playlist_core"; then core=$CORE_PATH
        elif ext_core_for "$rom" "$ext" && core_path_for "$EXT_CORE"; then core=$CORE_PATH
        else continue
        fi

        if add_game "$rom" "$label" "${db%.lpl}" "$core" "$ext"; then
          playlist_count=$((playlist_count + 1))
        fi
      done < <(jq -j '
        (if type == "object" and (.items | type) == "array"
         then . else {items: []} end)
        | (.default_core_path // "") as $pc
        | .items[]
        | select((.path // "") != "" and (.label // "") != "")
        | ((.path // "") + "\u0000" + (.label // "") + "\u0000"
           + ((.core_path // "")) + "\u0000" + ($pc + "\u0000"))' "$lpl" 2>/dev/null)
    done < <(find "$PLAYLIST_DIR" -maxdepth 1 -type f -name '*.lpl' -print0 2>/dev/null)
  fi

  local plays_json="{}"
  if [[ -f $PLAYS_FILE ]]; then
    plays_json=$(jq -c 'if type == "object" then . else {} end' "$PLAYS_FILE" 2>/dev/null) || plays_json="{}"
  fi

  local added_json="{}"
  if [[ -f $ADDED_FILE ]]; then
    added_json=$(jq -c 'if type == "object" then . else {} end' "$ADDED_FILE" 2>/dev/null) || added_json="{}"
  fi
  local now
  now=$(date +%s)

  # Stream tagged NDJSON out of jq one line at a time instead of assembling a
  # single document: every line is handed to whoever is reading as it is
  # produced, so neither this script nor the long-lived shell ever holds the
  # whole library as text. Line protocol, in emission order:
  #   {"t":"added","state":{...}}   first-seen index, consumed internally
  #   {"t":"header","games":N}
  #   {"t":"game","g":{...}}        one per game
  #   {"t":"trailer",...}           extension table and meta
  local added_line="" saw_header=0 saw_trailer=0 game_count=0 line
  ADDED_TMP=$(mktemp "$STATE_DIR/.added-XXXXXX.json") || die "could not create added-state temp file"

  while IFS= read -r line; do
    case $line in
      '{"t":"added",'*)
        # The only tag held back: the first-seen index is persisted below,
        # after the stream has proven complete, and never reaches stdout.
        added_line=$line
        ;;
      '{"t":"header",'*)
        saw_header=1
        printf '%s\n' "$line"
        ;;
      '{"t":"game",'*)
        game_count=$((game_count + 1))
        printf '%s\n' "$line"
        ;;
      '{"t":"trailer",'*)
        saw_trailer=1
        printf '%s\n' "$line"
        ;;
      *)
        # An unrecognised tag is skipped rather than forwarded or fatal, so
        # the protocol can grow without breaking an older reader mid-scan.
        ;;
    esac
  done < <(jq -c -Rsc --argjson plays "$plays_json" \
    --argjson added "$added_json" \
    --argjson now "$now" \
    --argjson cores "$CORES_JSON" \
    --arg playlistDir "$PLAYLIST_DIR" \
    --argjson fromPlaylists "$playlist_count" \
    --argjson retroarch "$RETROARCH_PRESENT" '
    (split("\u0000")
      | if .[-1] == "" then .[:-1] else . end
      | [range(0; length; 12) as $i
        | {
            key: (.[$i] | .[0:4096]), title: (.[$i + 1] | .[0:512]),
            system: (.[$i + 2] | .[0:512]), ext: (.[$i + 3] | .[0:64]),
            core: (.[$i + 4] | .[0:4096]), coreName: (.[$i + 5] | .[0:512]),
            rom: (.[$i + 6] | .[0:4096]), art: (.[$i + 7] | .[0:4096]),
            resumeSlot: (.[$i + 8] | .[0:16]),
            resumeAt: ((.[$i + 9] | .[0:32]) | tonumber),
            resumeArt: (.[$i + 10] | .[0:4096]),
            slots: (.[$i + 11] | .[0:512])
          }])
    | map(. as $game
      | ($plays[$game.rom] // {}) as $play
      | $game + {
          lastPlayed: (($play.lastPlayed // 0) | floor),
          playSeconds: (($play.seconds // 0) | floor),
          playCount: (($play.count // 0) | floor)
        })
      | sort_by(.title | ascii_downcase) as $sorted
     | (reduce $sorted[] as $game ($added;
          if has($game.rom) then . else .[$game.rom] = $now end)) as $nextAdded
     | ($sorted | map(. + {addedAt: (($nextAdded[.rom] // $now) | floor)})) as $dated
     | ($dated | map(.ext) | unique | map(select(. != ""))) as $exts
     | {t: "added", state: $nextAdded},
       {t: "header", games: ($dated | length)},
       ($dated[] | {t: "game", g: .}),
       {t: "trailer",
          extensions: [
            $exts[]
            | . as $e
            | (($cores.cores // []) | map(select(.extensions | index($e)))) as $cands
            | {
                ext: $e,
                candidates: [ $cands[] | { id: .id, name: .corename, system: .system } ],
                chosen: ((($cores.choices // {})[$e]) // ""),
                resolved: (($dated | map(select(.ext == $e)) | first | .coreName) // "")
              }
          ],
          meta: {
            playlistDir: $playlistDir,
            fromPlaylists: $fromPlaylists,
            retroarchInstalled: $retroarch,
            coreCount: ((($cores.meta // {}).coreCount) // 0)
          }}' "$RECORDS_FILE")

  # Fail closed on an incomplete stream rather than emitting something that
  # looks like an empty library because jq died partway through.
  (( saw_header && saw_trailer )) || die "could not build library output"
  if (( game_count != playlist_count )); then
    die "lost $((playlist_count - game_count)) games building library output"
  fi

  # First-seen dates persist only when they changed, and only once the stream
  # finished cleanly: an interrupted scan must never truncate them.
  if [[ -n $added_line && $added_line != "{\"t\":\"added\",\"state\":${added_json}}" ]]; then
    if ! jq -c '.state' <<<"$added_line" >"$ADDED_TMP" 2>/dev/null; then
      rm -f "$ADDED_TMP"
      ADDED_TMP=""
      die "could not persist added dates"
    fi
    mv -f "$ADDED_TMP" "$ADDED_FILE"
    ADDED_TMP=""
  else
    rm -f "$ADDED_TMP"
    ADDED_TMP=""
  fi
}

effective_ext() {
  EXT=""
  local base="${1##*/}"
  [[ $base == *.* ]] || return 1
  EXT="${base##*.}"
  EXT="${EXT,,}"
}

ext_core_for() {
  EXT_CORE=""
  local rom="$1" ext="${2:-}"
  if [[ -z $ext ]]; then
    effective_ext "$rom" || return 1
    ext=$EXT
  fi
  [[ -n $ext ]] || return 1

  # A recorded choice wins, but only while that core is still installed --
  # uninstalling a core should not turn its games into dead rows.
  local chosen="${EXT_CHOICE[$ext]:-}"
  if [[ -n $chosen ]] && core_path_for "$chosen"; then
    EXT_CORE="$chosen"
    return 0
  fi

  local candidates="${EXT_CANDIDATES[$ext]:-}"
  [[ -n $candidates ]] || return 1
  # Deterministic: jq sorted the candidate list, so the same library resolves
  # the same way on every scan rather than shuffling under the user.
  EXT_CORE="${candidates%% *}"
}
add_game() {
  local rom="$1" label="$2" db="$3" core="$4" ext="${5:-}"

  local art=""
  boxart_for "$db" "$label" && art=$BOXART

  local slot="" resume_at=0 resume_art="" slots=""
  if newest_state "$rom" "$core"; then
    IFS=$'\x1f' read -r slot resume_at resume_art slots <<<"$STATE_INFO"
  fi

  local core_name="${core##*/}"
  core_name="${core_name%_libretro.so}"

  if [[ -z $ext ]]; then
    effective_ext "$rom" || true
    ext=$EXT
  fi

  # Use the core system when the playlist has no system name.
  [[ -n $db ]] || db="${CORE_SYSTEM[$core_name]:-}"

  printf '%s\0' "$rom" "$label" "$db" "$ext" "$core" "$core_name" \
    "$rom" "$art" "$slot" "${resume_at:-0}" "$resume_art" "${slots:-}" >>"$RECORDS_FILE"
}

# A cheap signature of everything a scan depends on: the save states, the
# playlists, and the core choices. Milliseconds against a hundred games, so
# the panel can poll it and only pay for a full rescan when something has
# actually changed.
#
# From retroarch.cfg only the five resolved path keys are hashed, not the
# file: RetroArch rewrites the whole config on nearly any GUI settings
# change -- shaders, aspect ratio, input tweaks -- and none of that changes
# what a scan would produce. The paths themselves are read once above, so a
# genuine directory move still shows up here.
#
# Thumbnails are deliberately absent: art for an existing game appears only
# when RetroArch downloads it, which changes no file a scan reads, and the
# periodic rescan picks it up anyway. Walking tens of thousands of thumbnail
# files every poll was the dominant cold-cache cost.
#
# Polled rather than watched with inotify deliberately: inotify-tools is not
# guaranteed to be installed, a recursive watch on a large tree can exhaust
# the user's watch limit, and a long-lived monitor process is one more thing
# to keep alive across a shell restart. A 46ms find is none of those things.
fingerprint() {
  {
    printf 'playlist_directory=%s\nsavestate_directory=%s\nthumbnails_directory=%s\nlibretro_directory=%s\nlibretro_info_path=%s\n' \
      "$PLAYLIST_DIR" "$SAVESTATE_DIR" "$THUMBNAIL_DIR" "$CORE_DIR" "$INFO_DIR"
    find "$SAVESTATE_DIR" -type f -printf '%T@\t%s\t%p\n' 2>/dev/null
    find "$PLAYLIST_DIR" -maxdepth 1 -type f -name '*.lpl' -printf '%T@\t%s\t%p\n' 2>/dev/null
    find "$CORE_DIR" -maxdepth 1 -type f -name '*_libretro.so' -printf '%T@\t%s\t%p\n' 2>/dev/null
    find "$INFO_DIR" -maxdepth 1 -type f -name '*.info' -printf '%T@\t%s\t%p\n' 2>/dev/null
    [[ -f $CORES_CONF ]] && { printf 'cores.conf\t'; cat "$CORES_CONF"; }
  } | sort | cksum | tr -d ' \n'
  printf '\n'
}

case "${1:-}" in
  --fingerprint)
    fingerprint
    exit 0
    ;;
  -h|--help)
    cat <<USAGE
Usage: omarchy-arcade-scan [--fingerprint]

Prints the Arcade game library to stdout as tagged newline-delimited
JSON, one object per line, streamed as it is built:
  {"t":"header",...} {"t":"game","g":{...}}* {"t":"trailer",...}
The first-seen index line is consumed internally and never printed.

  --fingerprint  Print a short signature of the ROM tree, save states,
                 playlists, and core choices instead. Changes whenever a full
                 rescan would produce different output, and costs
                 milliseconds, so it is cheap to poll.

Environment:
  RA_CONFIG_DIR    Override the RetroArch config directory

Config:
  ~/.config/omarchy/arcade/cores.conf   One "ext = core" per line, choosing
                                        which installed core opens extensions
                                        that more than one core claims.
USAGE
    exit 0
    ;;
esac

emit_games
