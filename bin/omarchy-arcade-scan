#!/bin/bash

# Emit the Arcade game library as a single JSON object on stdout.
#
# Two sources, tried in that order:
#
#   1. RetroArch playlists (*.lpl). Authoritative when the user has run
#      RetroArch's own scanner, because the playlist carries the real system
#      name and the core RetroArch itself chose for each entry.
#   2. A walk of the ROM directory. The fallback for a fresh Omarchy install,
#      where the playlist directory is empty but ~/Games/roms already has
#      files in it. Extension picks the core.
#
# Both sources feed the same record shape, so the overlay never learns which
# one a game came from.

set -uo pipefail

RA_CONFIG_DIR="${RA_CONFIG_DIR:-$HOME/.config/retroarch}"
RA_CFG="$RA_CONFIG_DIR/retroarch.cfg"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-arcade"
PLAYS_FILE="$STATE_DIR/plays.json"
CORES_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/arcade/cores.conf"
RECORDS_FILE=""

die() {
  echo "omarchy-arcade-scan: $*" >&2
  exit 1
}

command -v jq >/dev/null || die "jq is required"

# Reported rather than fatal: a machine without RetroArch is a machine that
# has not installed it yet, and the panel offers Omarchy's installer instead
# of an error.
if command -v retroarch >/dev/null; then RETROARCH_PRESENT=true; else RETROARCH_PRESENT=false; fi

# RetroArch writes `key = "value"` with a literal ~ left unexpanded, and uses
# ":" to mean the config directory itself.
ra_cfg() {
  local key="$1" fallback="$2" value=""
  if [[ -f $RA_CFG ]]; then
    value=$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"\(.*\)\"[[:space:]]*$/\1/p" "$RA_CFG" | tail -n1)
  fi
  [[ -n $value ]] || value="$fallback"
  value="${value/#:/$RA_CONFIG_DIR}"
  value="${value/#\~/$HOME}"
  printf '%s' "$value"
}

PLAYLIST_DIR=$(ra_cfg playlist_directory "$RA_CONFIG_DIR/playlists")
SAVESTATE_DIR=$(ra_cfg savestate_directory "$RA_CONFIG_DIR/states")
THUMBNAIL_DIR=$(ra_cfg thumbnails_directory "$RA_CONFIG_DIR/thumbnails")
CORE_DIR=$(ra_cfg libretro_directory "/usr/lib/libretro")
ROM_DIR="${ARCADE_ROM_DIR:-$(ra_cfg rgui_browser_directory "$HOME/Games/roms")}"

# Which cores can open which extension comes from RetroArch's own .info
# files, read by omarchy-arcade-cores, rather than a table maintained here.
# Taking RetroArch at its word means the candidate list is right for whatever
# the user actually has installed -- and it means several cores usually claim
# the same extension, which is a choice for the user rather than something to
# guess at quietly. cores.conf records that choice; until it is made, the
# first candidate is used so the game is still launchable, and the extension
# is reported as ambiguous so the panel can offer the picker.
declare -A EXT_CANDIDATES EXT_CHOICE CORE_SYSTEM

load_cores() {
  local raw
  raw=$("$(dirname "${BASH_SOURCE[0]}")/omarchy-arcade-cores" list 2>/dev/null) || return 1
  [[ -n $raw ]] || return 1

  local ext ids
  while IFS=$'\t' read -r ext ids; do
    [[ -n $ext ]] || continue
    EXT_CANDIDATES[$ext]="$ids"
  done < <(jq -r '.byExtension | to_entries[] | "\(.key)\t\(.value | join(" "))"' <<<"$raw" 2>/dev/null)

  local core
  while IFS=$'\t' read -r ext core; do
    [[ -n $ext ]] || continue
    EXT_CHOICE[$ext]="$core"
  done < <(jq -r '.choices | to_entries[] | "\(.key)\t\(.value)"' <<<"$raw" 2>/dev/null)

  # RetroArch's .info files name the system each core emulates. That is the
  # only system a walked ROM has -- there is no playlist to name it -- and
  # without one the library cannot be browsed by system at all.
  local id system
  while IFS=$'\t' read -r id system; do
    [[ -n $id ]] || continue
    CORE_SYSTEM[$id]="$system"
  done < <(jq -r '.cores[] | "\(.id)\t\(.system)"' <<<"$raw" 2>/dev/null)

  CORES_JSON="$raw"
}

CORES_JSON="{}"

core_path_for() {
  local name="$1"
  [[ -n $name ]] || return 1
  # "DETECT" is what RetroArch writes when a playlist entry is not pinned to a
  # core, which is the default outcome of scanning a directory. It is a
  # sentinel, not a core name, and the caller has to fall through to the next
  # source rather than treat it as an answer.
  [[ $name == DETECT ]] && return 1
  # Accept a bare core name, a filename, or an absolute path, so the same
  # helper serves cores.conf and a playlist's core_path alike.
  if [[ $name == /* ]]; then
    [[ -f $name ]] && printf '%s' "$name" && return 0
    return 1
  fi
  local candidate="$CORE_DIR/${name%_libretro.so}_libretro.so"
  [[ -f $candidate ]] && printf '%s' "$candidate" && return 0
  return 1
}

# RetroArch can be told to sort save states into a subdirectory per core
# (`sort_savestates_enable`, which is on by default), so the states for one
# ROM are not necessarily in the directory the config names -- they may be one
# or two levels below it. Walk the tree once up front and index by ROM
# basename rather than guessing at a path per game.
declare -A STATE_SLOT STATE_MTIME STATE_THUMB

index_states() {
  [[ -d $SAVESTATE_DIR ]] || return 0

  local f fname base slot mtime
  while IFS= read -r -d '' f; do
    fname="${f##*/}"
    # `.state.png` is the thumbnail beside a state, not a state itself.
    [[ $fname == *.png ]] && continue

    if [[ $fname == *.state ]]; then
      base="${fname%.state}"; slot=0
    elif [[ $fname == *.state.auto ]]; then
      base="${fname%.state.auto}"; slot=auto
    elif [[ $fname =~ ^(.+)\.state([0-9])$ ]]; then
      base="${BASH_REMATCH[1]}"; slot="${BASH_REMATCH[2]}"
    else
      continue
    fi

    mtime=$(stat -c %Y "$f" 2>/dev/null) || continue
    if [[ -z ${STATE_MTIME[$base]:-} ]] || (( mtime > ${STATE_MTIME[$base]} )); then
      STATE_MTIME[$base]=$mtime
      STATE_SLOT[$base]=$slot
      if [[ -f "$f.png" ]]; then STATE_THUMB[$base]="$f.png"; else STATE_THUMB[$base]=""; fi
    fi
  done < <(find "$SAVESTATE_DIR" -type f -print0 2>/dev/null)
}

# "slot<TAB>mtime<TAB>thumbnail" for a ROM, or non-zero when it has no state.
# The slot is a string rather than a number because "auto" is a real slot that
# no integer names, and reusing a negative integer for it collides with the
# "no state at all" sentinel.
newest_state() {
  local rom="$1"
  local base="${rom##*/}"
  base="${base%.*}"
  [[ -n ${STATE_MTIME[$base]:-} ]] || return 1
  printf '%s\t%s\t%s' "${STATE_SLOT[$base]}" "${STATE_MTIME[$base]}" "${STATE_THUMB[$base]}"
}

# RetroArch stores box art under the playlist's own name. Only the playlist
# source knows that name, so the ROM walk simply has no art to offer.
boxart_for() {
  local db="$1" label="$2"
  [[ -n $db && -n $label ]] || return 1
  db="${db%.lpl}"
  # RetroArch replaces characters that are illegal in filenames with "_".
  local safe="${label//[&*\/:\`<>?\\|\"]/_}"
  local candidate="$THUMBNAIL_DIR/$db/Named_Boxarts/$safe.png"
  [[ -f $candidate ]] && printf '%s' "$candidate" && return 0
  return 1
}

emit_games() {
  local playlist_count=0 walk_count=0
  # ROMs a playlist already claimed. The walk consults this so the two sources
  # union instead of competing: a scanned game keeps its playlist metadata,
  # and an unscanned one still shows up.
  declare -A SEEN_ROM

  RECORDS_FILE=$(mktemp -t omarchy-arcade-scan-XXXXXX.jsonl) || die "could not create scan records"
  trap 'rm -f "$RECORDS_FILE"' EXIT

  index_states
  load_cores || true

  # --- Source 1: playlists ------------------------------------------------
  if [[ -d $PLAYLIST_DIR ]]; then
    local lpl
    while IFS= read -r -d '' lpl; do
      # A malformed playlist should cost its own entries, not the whole scan.
      jq -e 'type == "object" and (.items | type == "array")' "$lpl" >/dev/null 2>&1 || continue
      local db
      db="${lpl##*/}"
      # A playlist can pin one core for all of its entries. When it does, that
      # is a deliberate choice by the user and outranks our extension guess.
      local playlist_core
      playlist_core=$(jq -r '.default_core_path // ""' "$lpl" 2>/dev/null)
      local entries
      entries=$(jq -c --arg db "$db" '
        [ .items[]
          | select((.path // "") != "" and (.label // "") != "")
          | { path: .path, label: .label, core_path: (.core_path // ""), db: $db }
        ]' "$lpl" 2>/dev/null) || continue

      local entry
      while IFS= read -r entry; do
        [[ -n $entry ]] || continue
        local rom label core_hint
        rom=$(jq -r '.path' <<<"$entry")
        label=$(jq -r '.label' <<<"$entry")
        core_hint=$(jq -r '.core_path' <<<"$entry")
        # Playlists survive the ROMs they point at; a dead entry would render
        # as a tile that does nothing when you press Enter.
        [[ -f $rom ]] || continue

        # Which emulator runs this ROM, most specific answer first:
        #   1. the core this entry is pinned to
        #   2. the core the whole playlist is pinned to
        #   3. our extension map (which cores.conf can override)
        # A ROM none of them can answer for is skipped rather than launched
        # under a guess.
        local core
        core=$(core_path_for "$core_hint") \
          || core=$(core_path_for "$playlist_core") \
          || core=$(core_path_for "$(ext_core_for "$rom")") \
          || continue

        if add_game "$rom" "$label" "${db%.lpl}" "$core"; then
          SEEN_ROM["$rom"]=1
          playlist_count=$((playlist_count + 1))
        fi
      done < <(jq -c '.[]' <<<"$entries" 2>/dev/null)
    done < <(find "$PLAYLIST_DIR" -maxdepth 1 -type f -name '*.lpl' -print0 2>/dev/null)
  fi

  # --- Source 2: ROM directory walk ---------------------------------------
  # Always runs. Scanning content into a RetroArch playlist is something
  # people do a few games at a time, so a library is usually part scanned and
  # part not; letting the playlist suppress the walk hid every ROM the user
  # had not got round to importing yet. Anything a playlist already claimed is
  # skipped here so it keeps the better metadata rather than appearing twice.
  if [[ -d $ROM_DIR ]]; then
    local rom
    while IFS= read -r -d '' rom; do
      [[ -z ${SEEN_ROM["$rom"]:-} ]] || continue

      local core_name core
      core_name=$(ext_core_for "$rom") || continue
      core=$(core_path_for "$core_name") || continue

      local label
      label=$(walk_label "$rom")
      if add_game "$rom" "$label" "" "$core"; then
        walk_count=$((walk_count + 1))
      fi
    done < <(find "$ROM_DIR" -type f -print0 2>/dev/null)
  fi

  local plays_json="{}" games_json="[]"
  if [[ -f $PLAYS_FILE ]]; then
    plays_json=$(jq -c 'if type == "object" then . else {} end' "$PLAYS_FILE" 2>/dev/null) || plays_json="{}"
  fi
  games_json=$(jq -cs --argjson plays "$plays_json" '
    map(. as $game
      | ($plays[$game.rom] // {}) as $play
      | $game + {
          lastPlayed: (($play.lastPlayed // 0) | floor),
          playSeconds: (($play.seconds // 0) | floor),
          playCount: (($play.count // 0) | floor)
        })' "$RECORDS_FILE") || games_json="[]"

  jq -n \
    --argjson games "$games_json" \
    --argjson cores "$CORES_JSON" \
    --arg romDir "$ROM_DIR" \
    --arg playlistDir "$PLAYLIST_DIR" \
    --argjson fromPlaylists "$playlist_count" \
    --argjson fromWalk "$walk_count" \
    --argjson retroarch "$RETROARCH_PRESENT" \
    '($games | sort_by(.title | ascii_downcase)) as $sorted
     | ($sorted | map(.ext) | unique | map(select(. != ""))) as $exts
     | {
         games: $sorted,
         extensions: [
           $exts[]
           | . as $e
           | (($cores.cores // []) | map(select(.extensions | index($e)))) as $cands
           | {
               ext: $e,
               candidates: [ $cands[] | { id: .id, name: .corename, system: .system } ],
               chosen: ((($cores.choices // {})[$e]) // ""),
               resolved: (($sorted | map(select(.ext == $e)) | first | .coreName) // "")
             }
         ],
         meta: {
           romDir: $romDir,
           playlistDir: $playlistDir,
           fromPlaylists: $fromPlaylists,
           fromWalk: $fromWalk,
           retroarchInstalled: $retroarch,
           coreCount: ((($cores.meta // {}).coreCount) // 0)
         }
       }'
}

# Folder name to the extension it stands for. ROM collections are commonly
# laid out as roms/<system>/, the convention RetroPie and EmulationStation
# established, and it is the only hint available for a file with no extension
# at all -- which is most of a collection downloaded as a set.
declare -A DIR_EXT=(
  [snes]=sfc [sfc]=sfc [supernintendo]=sfc [super-nintendo]=sfc [superfamicom]=sfc
  [nes]=nes [famicom]=nes [nintendo]=nes
  [gb]=gb [gameboy]=gb [game-boy]=gb
  [gbc]=gbc [gameboycolor]=gbc
  [gba]=gba [gameboyadvance]=gba
  [n64]=n64 [nintendo64]=n64
  [nds]=nds [ds]=nds
  [genesis]=md [megadrive]=md [md]=md [segagenesis]=md
  [sms]=sms [mastersystem]=sms
  [gg]=gg [gamegear]=gg
  [pce]=pce [turbografx]=pce [turbografx16]=pce
)

# libmagic recognises most ROM images by content, which beats any convention
# when a collection is a flat folder of extensionless files. Matched against
# the description `file -b` prints, longest-lived substrings only.
sniff_ext() {
  command -v file >/dev/null || return 1
  local desc
  desc=$(file -b "$1" 2>/dev/null) || return 1
  case "$desc" in
    "Super NES ROM image"*|"Super Nintendo"*) printf 'sfc' ;;
    *"Nintendo Entertainment System ROM"*|"iNES"*|*" iNES"*) printf 'nes' ;;
    "Game Boy Advance ROM"*) printf 'gba' ;;
    "Game Boy Color ROM"*) printf 'gbc' ;;
    "Game Boy ROM"*) printf 'gb' ;;
    "Nintendo 64 ROM"*|"N64 ROM"*) printf 'n64' ;;
    "Sega Mega Drive"*|"Sega Genesis"*) printf 'md' ;;
    "Sega Master System"*) printf 'sms' ;;
    *) return 1 ;;
  esac
}

# The extension to resolve a core with, which is not always the one on the
# filename -- most of a downloaded collection has no extension at all.
# `${rom##*.}` is not enough on its own: on a name with no dot it returns the
# whole name, which then silently matches nothing.
effective_ext() {
  local rom="$1"
  local base="${rom##*/}"

  if [[ $base == *.* ]]; then
    tr '[:upper:]' '[:lower:]' <<<"${base##*.}"
    return 0
  fi

  local dir="${rom%/*}"
  dir="${dir##*/}"
  dir="$(tr '[:upper:]' '[:lower:]' <<<"$dir" | tr -d ' _')"
  if [[ -n ${DIR_EXT[$dir]:-} ]]; then
    printf '%s' "${DIR_EXT[$dir]}"
    return 0
  fi

  sniff_ext "$rom"
}

# A filename like "mightymorphinpowerrangers" carries no word boundaries, but
# the ROM header does -- libmagic prints the internal title, and that is the
# name the game actually shipped under. Only used when the filename looks
# machine-squashed: no spaces, no separators, no capitals. A filename someone
# clearly typed ("Super Mario World (USA)", "a-plumber-for-all-seasons") is
# better than any header and is left alone.
is_squashed_name() {
  local stem="$1"
  [[ ${#stem} -ge 3 ]] || return 1
  [[ $stem != *[[:space:]]* ]] || return 1
  [[ $stem != *-* ]] || return 1
  [[ $stem != *_* ]] || return 1
  [[ $stem != *[[:upper:]]* ]] || return 1
  return 0
}

rom_internal_title() {
  command -v file >/dev/null || return 1
  local desc title
  desc=$(file -b -- "$1" 2>/dev/null) || return 1
  # libmagic renders the header name in quotes: ROM image "CHRONO TRIGGER" ...
  # Matched in-shell rather than through sed, because this runs once per ROM
  # and a second subprocess per file doubled the scan time on a real library.
  [[ $desc =~ \"([^\"]+)\" ]] || return 1
  title="${BASH_REMATCH[1]}"
  title="${title#"${title%%[![:space:]]*}"}"
  title="${title%"${title##*[![:space:]]}"}"
  [[ -n $title ]] || return 1
  printf '%s' "$title"
}

# The best label for a ROM the walk found, which is usually its filename.
walk_label() {
  local rom="$1"
  local stem="${rom##*/}"
  [[ $stem == *.* ]] && stem="${stem%.*}"

  if is_squashed_name "$stem"; then
    local internal
    internal=$(rom_internal_title "$rom") && { printf '%s' "$internal"; return 0; }
  fi
  printf '%s' "$stem"
}

ext_core_for() {
  local ext
  ext=$(effective_ext "$1") || return 1
  [[ -n $ext ]] || return 1

  # A recorded choice wins, but only while that core is still installed --
  # uninstalling a core should not turn its games into dead rows.
  local chosen="${EXT_CHOICE[$ext]:-}"
  if [[ -n $chosen ]] && core_path_for "$chosen" >/dev/null; then
    printf '%s' "$chosen"
    return 0
  fi

  local candidates="${EXT_CANDIDATES[$ext]:-}"
  [[ -n $candidates ]] || return 1
  # Deterministic: jq sorted the candidate list, so the same library resolves
  # the same way on every scan rather than shuffling under the user.
  printf '%s' "${candidates%% *}"
}

# Is this extension one the user still has a decision to make about?
ext_ambiguous() {
  local ext="$1"
  [[ -z ${EXT_CHOICE[$ext]:-} ]] || return 1
  local candidates="${EXT_CANDIDATES[$ext]:-}"
  [[ $candidates == *" "* ]]
}

add_game() {
  local rom="$1" label="$2" db="$3" core="$4"

  local art=""
  art=$(boxart_for "$db" "$label") || art=""

  local slot="" resume_at=0 resume_art="" state
  if state=$(newest_state "$rom"); then
    IFS=$'\t' read -r slot resume_at resume_art <<<"$state"
  fi

  local core_name="${core##*/}"
  core_name="${core_name%_libretro.so}"

  local ext
  ext=$(effective_ext "$rom") || ext=""

  # A walked ROM has no playlist to name its system, so borrow the one
  # RetroArch attributes to the core that will run it. Deliberately after
  # boxart_for above: thumbnails live under a playlist's name, and a core's
  # system name is not one.
  [[ -n $db ]] || db="${CORE_SYSTEM[$core_name]:-}"

  jq -c \
    --arg key "$rom" \
    --arg ext "$ext" \
    --arg title "$label" \
    --arg system "$db" \
    --arg core "$core" \
    --arg coreName "$core_name" \
    --arg rom "$rom" \
    --arg art "$art" \
    --arg resumeSlot "$slot" \
    --argjson resumeAt "${resume_at:-0}" \
    --arg resumeArt "$resume_art" \
    -n '{
      key: $key, title: $title, system: $system, ext: $ext,
      core: $core, coreName: $coreName, rom: $rom, art: $art,
      resumeSlot: $resumeSlot, resumeAt: $resumeAt, resumeArt: $resumeArt
    }' >>"$RECORDS_FILE"
}

# A cheap signature of everything a scan depends on: the ROM tree, the save
# states, the playlists, and the core choices. Milliseconds against a hundred
# games, so the panel can poll it and only pay for a full rescan when
# something has actually changed.
#
# Polled rather than watched with inotify deliberately: inotify-tools is not
# guaranteed to be installed, a recursive watch on a large tree can exhaust
# the user's watch limit, and a long-lived monitor process is one more thing
# to keep alive across a shell restart. A 46ms find is none of those things.
fingerprint() {
  {
    find "$ROM_DIR" -type f -printf '%T@\t%s\t%p\n' 2>/dev/null
    find "$SAVESTATE_DIR" -type f -printf '%T@\t%s\t%p\n' 2>/dev/null
    find "$PLAYLIST_DIR" -maxdepth 1 -type f -name '*.lpl' -printf '%T@\t%s\t%p\n' 2>/dev/null
    # Folded in by content, not mtime: stat's %Y has whole-second resolution,
    # so a choice written in the same second as the previous check would have
    # produced an identical signature and stayed invisible for good. The ROM
    # and state entries above use %T@, which is fractional, so they are safe.
    [[ -f $CORES_CONF ]] && { printf 'cores.conf\t'; cat "$CORES_CONF"; }
  } | sort | cksum | tr -d ' \n'
  printf '\n'
}

case "${1:-}" in
  --fingerprint)
    fingerprint
    exit 0
    ;;
  -h|--help)
    cat <<USAGE
Usage: omarchy-arcade-scan [--fingerprint]

Prints the Arcade game library as JSON on stdout:
  { "games": [ ... ], "extensions": [ ... ], "meta": { ... } }

  --fingerprint  Print a short signature of the ROM tree, save states,
                 playlists, and core choices instead. Changes whenever a full
                 rescan would produce different output, and costs
                 milliseconds, so it is cheap to poll.

Environment:
  ARCADE_ROM_DIR   Override the ROM directory (default: RetroArch's
                   rgui_browser_directory, or ~/Games/roms)
  RA_CONFIG_DIR    Override the RetroArch config directory

Config:
  ~/.config/omarchy/arcade/cores.conf   One "ext = core" per line, to map
                                        extensions this scanner leaves alone.
USAGE
    exit 0
    ;;
esac

emit_games
