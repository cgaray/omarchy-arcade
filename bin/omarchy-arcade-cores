#!/bin/bash

# What RetroArch knows about the cores you have installed, and which one you
# picked for an extension.
#
# RetroArch ships a .info file per core declaring corename, systemname, and
# supported_extensions. That is the authoritative answer to "what can open
# this file", so Arcade reads it rather than carrying its own table of
# guesses. The list is taken as RetroArch gives it: if a core claims an
# extension, it is offered as a candidate, and choosing between candidates is
# the user's call -- which is what `set` records.

set -uo pipefail

RA_CONFIG_DIR="${RA_CONFIG_DIR:-$HOME/.config/retroarch}"
RA_CFG="$RA_CONFIG_DIR/retroarch.cfg"
CORES_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/arcade/cores.conf"
READ_HELPER="$(dirname "${BASH_SOURCE[0]}")/../lib/omarchy-arcade-read"

die() {
  echo "omarchy-arcade-cores: $*" >&2
  exit 1
}

command -v jq >/dev/null || die "jq is required"
command -v perl >/dev/null || die "perl is required"

# Both listings below fold one jq call per entry into an accumulator, so the
# work grows with the square of what the directory happens to contain -- and
# both directories are named by retroarch.cfg, which is the user's file. A
# machine has tens of cores and a handful of choices; these caps are far
# above that and exist only so a directory of junk cannot turn a scan, which
# runs this on every rescan, into an unbounded fan-out of processes.
MAX_CORES=512
MAX_CHOICES=512

# Whole-file reads are capped, and every cap is applied to the one stream its
# parser consumes -- never to a path sized separately and opened again, which
# is two opens of a name where what was measured need not be what gets read.
# retroarch.cfg and the .info files are named by the user's own config, and
# the scanner runs this on every rescan.
MAX_CFG_BYTES=$((1024 * 1024))
MAX_INFO_BYTES=$((1024 * 1024))
MAX_INFO_LINES=4096
MAX_INFO_VALUE_CHARS=4096
CORES_LOCK_WAIT=30

ra_cfg() {
  local key="$1" fallback="$2" value=""
  if [[ -f $RA_CFG ]]; then
    value=$("$READ_HELPER" "$MAX_CFG_BYTES" "$RA_CFG" 2>/dev/null \
      | sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"\(.*\)\"[[:space:]]*$/\1/p" | tail -n1)
  fi
  [[ -n $value ]] || value="$fallback"
  value="${value/#:/$RA_CONFIG_DIR}"
  value="${value/#\~/$HOME}"
  printf '%s' "$value"
}

CORE_DIR=$(ra_cfg libretro_directory "/usr/lib/libretro")
INFO_DIR=$(ra_cfg libretro_info_path "/usr/share/libretro/info")

# The four values a listing needs from one .info file, read once. Keys are
# `name = "value"`, one per line, and the first match for a key wins.
#
# One capped read rather than a sed pass per key: four passes was four opens
# of the same path -- so four chances for it to name a different file, and
# four unbounded reads -- and it ran per installed core on every rescan.
# Parsing in the shell keeps it to no forks at all.
read_info() {
  INFO_EXT=""; INFO_CORENAME=""; INFO_SYSTEM=""; INFO_DISPLAY=""
  local line key value lines=0
  while IFS= read -r line; do
    (( lines < MAX_INFO_LINES )) || break
    lines=$((lines + 1))
    [[ $line =~ ^[[:space:]]*([A-Za-z_]+)[[:space:]]*=[[:space:]]*\"(.*)\"[[:space:]]*$ ]] || continue
    key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]:0:MAX_INFO_VALUE_CHARS}"
    case $key in
      supported_extensions) [[ -n $INFO_EXT ]] || INFO_EXT="$value" ;;
      corename) [[ -n $INFO_CORENAME ]] || INFO_CORENAME="$value" ;;
      systemname) [[ -n $INFO_SYSTEM ]] || INFO_SYSTEM="$value" ;;
      display_name) [[ -n $INFO_DISPLAY ]] || INFO_DISPLAY="$value" ;;
    esac
  done < <("$READ_HELPER" "$MAX_INFO_BYTES" "$1" 2>/dev/null)
}

# Every installed core, with what RetroArch says it opens. A core with no
# .info file is still listed -- it is installed and launchable -- it just has
# no extensions to offer, so it never becomes an automatic candidate.
list_cores() {
  local so name info ext corename system display seen=0
  local out="[]"

  while IFS= read -r -d '' so; do
    if (( seen >= MAX_CORES )); then
      echo "omarchy-arcade-cores: reached the $MAX_CORES-core limit in $CORE_DIR" >&2
      break
    fi
    seen=$((seen + 1))
    name="$(basename "$so" .so)"
    info="$INFO_DIR/$name.info"
    ext=""; corename=""; system=""; display=""
    if [[ -f $info ]]; then
      read_info "$info"
      ext="$INFO_EXT"; corename="$INFO_CORENAME"
      system="$INFO_SYSTEM"; display="$INFO_DISPLAY"
    fi
    [[ -n $corename ]] || corename="${name%_libretro}"

    out=$(jq -c \
      --argjson acc "$out" \
      --arg id "${name%_libretro}" \
      --arg path "$so" \
      --arg corename "$corename" \
      --arg system "$system" \
      --arg display "$display" \
      --arg ext "$ext" \
      -n '$acc + [{
        id: $id,
        path: $path,
        corename: $corename,
        system: $system,
        displayName: (if $display == "" then $corename else $display end),
        extensions: ($ext | if . == "" then [] else split("|") end | map(ascii_downcase) | unique)
      }]')
  done < <(find "$CORE_DIR" -maxdepth 1 -type f -name '*_libretro.so' -print0 2>/dev/null \
    | head -z -n $((MAX_CORES + 1)))

  printf '%s' "$out"
}

# The user's choices, as { ext: coreId }.
read_choices() {
  local out="{}"
  [[ -f $CORES_CONF ]] || { printf '%s' "$out"; return; }

  local line ext core seen=0
  while IFS= read -r line; do
    if (( seen >= MAX_CHOICES )); then
      echo "omarchy-arcade-cores: reached the $MAX_CHOICES-line limit in $CORES_CONF" >&2
      break
    fi
    seen=$((seen + 1))
    line="${line%%#*}"
    [[ $line == *=* ]] || continue
    ext="$(tr -d '[:space:]' <<<"${line%%=*}" | tr '[:upper:]' '[:lower:]')"
    core="$(tr -d '[:space:]' <<<"${line#*=}")"
    [[ -n $ext && -n $core ]] || continue
    out=$(jq -c --argjson acc "$out" --arg e "$ext" --arg c "$core" -n '$acc + {($e): $c}')
  done < <("$READ_HELPER" "$MAX_CFG_BYTES" "$CORES_CONF" 2>/dev/null)
  printf '%s' "$out"
}

emit_list() {
  local cores choices
  cores=$(list_cores)
  choices=$(read_choices)

  # byExtension inverts the core list so the scanner and the picker both ask
  # the same question -- "who can open a .sfc" -- of the same data.
  jq -n \
    --argjson cores "$cores" \
    --argjson choices "$choices" \
    --arg coreDir "$CORE_DIR" \
    --arg infoDir "$INFO_DIR" \
    '{
      cores: $cores,
      choices: $choices,
      byExtension: (
        reduce ($cores[] | . as $c | $c.extensions[] | {ext: ., id: $c.id}) as $pair
          ({}; .[$pair.ext] += [$pair.id])
        | map_values(unique)
      ),
      meta: { coreDir: $coreDir, infoDir: $infoDir, coreCount: ($cores | length) }
    }'
}

# The current cores.conf into CONF_BODY through a single capped read, or a
# refusal. A file past the cap is not one this tool wrote, and truncating a
# user's config to fit is worse than declining to rewrite it -- so the size
# is judged from the bytes actually read, not from a separate stat of a path
# that need not name the same file by the time it is reopened.
read_conf_body() {
  CONF_BODY=""
  [[ -f $CORES_CONF ]] || return 0
  if ! CONF_BODY=$("$READ_HELPER" $((MAX_CFG_BYTES + 1)) "$CORES_CONF" 2>/dev/null); then
    die "cores.conf is unreadable; refusing to rewrite it"
  fi
  if (( $(printf '%s' "$CONF_BODY" | wc -c) > MAX_CFG_BYTES )); then
    die "cores.conf is larger than $MAX_CFG_BYTES bytes; refusing to rewrite it"
  fi
}

# Record a choice. Validated against installed cores so the file cannot name
# something that will fail at launch.
set_choice() {
  local ext="$1" core="$2"
  ext="$(tr '[:upper:]' '[:lower:]' <<<"$ext")"
  [[ $ext =~ ^[a-z0-9]+$ ]] || die "invalid extension: $ext"
  [[ -f "$CORE_DIR/${core}_libretro.so" ]] || die "core is not installed: $core"

  mkdir -p "$(dirname "$CORES_CONF")"
  # Append, not truncate: bash redirection follows symlinks, so a '>' on this
  # predictable path would empty whatever the link names. The fd is only ever
  # flock'd, never written, so append mode costs nothing and leaves no
  # truncation primitive behind for anything that can write this directory.
  exec {CORES_LOCK_FD}>>"$CORES_CONF.lock" || die "could not open cores lock"
  flock -w "$CORES_LOCK_WAIT" "$CORES_LOCK_FD" || die "gave up waiting ${CORES_LOCK_WAIT}s for cores.conf"

  # Rewrite through a temp file so an interrupted write cannot truncate the
  # user's other choices. The temp file lives beside CORES_CONF so the final
  # mv is an atomic rename rather than a cross-filesystem copy.
  read_conf_body
  local tmp
  tmp=$(mktemp "$(dirname "$CORES_CONF")/.cores-XXXXXX") || die "could not create temp file"
  if [[ -n $CONF_BODY ]]; then
    grep -vE "^[[:space:]]*${ext}[[:space:]]*=" <<<"$CONF_BODY" >"$tmp" 2>/dev/null
  else
    printf '# Which core opens which extension. Written by Arcade.\n' >"$tmp"
  fi
  printf '%s = %s\n' "$ext" "$core" >>"$tmp"
  mv -f "$tmp" "$CORES_CONF"
  exec {CORES_LOCK_FD}>&-
  echo "ok"
}

unset_choice() {
  local ext="$1"
  ext="$(tr '[:upper:]' '[:lower:]' <<<"$ext")"
  [[ $ext =~ ^[a-z0-9]+$ ]] || die "invalid extension: $ext"
  mkdir -p "$(dirname "$CORES_CONF")"
  # Append, not truncate: bash redirection follows symlinks, so a '>' on this
  # predictable path would empty whatever the link names. The fd is only ever
  # flock'd, never written, so append mode costs nothing and leaves no
  # truncation primitive behind for anything that can write this directory.
  exec {CORES_LOCK_FD}>>"$CORES_CONF.lock" || die "could not open cores lock"
  flock -w "$CORES_LOCK_WAIT" "$CORES_LOCK_FD" || die "gave up waiting ${CORES_LOCK_WAIT}s for cores.conf"
  [[ -f $CORES_CONF ]] || { exec {CORES_LOCK_FD}>&-; echo "ok"; return; }
  read_conf_body
  local tmp
  tmp=$(mktemp "$(dirname "$CORES_CONF")/.cores-XXXXXX") || die "could not create temp file"
  grep -vE "^[[:space:]]*${ext}[[:space:]]*=" <<<"$CONF_BODY" >"$tmp" 2>/dev/null
  mv -f "$tmp" "$CORES_CONF"
  exec {CORES_LOCK_FD}>&-
  echo "ok"
}

case "${1:-list}" in
  list)
    emit_list
    ;;
  set)
    [[ $# -eq 3 ]] || die "usage: omarchy-arcade-cores set <ext> <core>"
    set_choice "$2" "$3"
    ;;
  unset)
    [[ $# -eq 2 ]] || die "usage: omarchy-arcade-cores unset <ext>"
    unset_choice "$2"
    ;;
  -h|--help)
    cat <<USAGE
Usage: omarchy-arcade-cores [list|set <ext> <core>|unset <ext>]

  list             JSON: installed cores, their extensions (from RetroArch's
                   own .info files), your recorded choices, and byExtension.
  set <ext> <core> Record which core opens <ext>. Refuses a core that is not
                   installed.
  unset <ext>      Forget a choice and go back to the default.

Choices live in ~/.config/omarchy/arcade/cores.conf, which you can also edit
by hand.
USAGE
    ;;
  *)
    die "unknown command: $1"
    ;;
esac
